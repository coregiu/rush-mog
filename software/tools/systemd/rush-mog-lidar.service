[Unit]
Description=RUSH-MOG D6/LD19 lidar driver (/scan)
After=network-online.target
Wants=network-online.target
# 接线/udev 未就绪时静默跳过；接好 /dev/rush_lidar 并重启后自动启动
ConditionPathExists=/dev/rush_lidar

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/edge_server
Environment=ROS_HOME=/var/lib/edge_server/ros
Environment=ROS_LOG_DIR=/var/log/edge_server/ros
Environment=PYTHONUNBUFFERED=1
Environment=EDGE_SERVER_CONFIG=/opt/edge_server/config/deploy.yaml
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /opt/edge_server/install/setup.bash && exec ros2 launch edge_server lidar.launch.py config_file:=/opt/edge_server/config/deploy.yaml'
Restart=on-failure
RestartSec=3
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
