[Unit]
Description=[LEGACY] RUSH-MOG ROS reporter (ROS 已并入 Edge Server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/rush-mog/edge-link.env
ExecStart=/usr/bin/python3 /opt/rush-mog/software/tools/edge_link.py --config /etc/rush-mog/ros-link.yaml
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
