# ROS 侧 edge_link 配置（部署到 /etc/rush-mog/ros-link.yaml）
# 启动：python3 edge_link.py --config /etc/rush-mog/ros-link.yaml
module: ros
name: "ROS 2 center_server"

# 自动连接 RUSH-MOG Wi-Fi（Linux NetworkManager）；密码可用环境变量
# RUSH_MOG_WIFI_PASSWORD 覆盖，避免写入配置文件。
connect_wifi: true
ssid: "RUSH-MOG"
password: ""

# ESP32-S3 AP 网关
edge_url: "http://192.168.4.1"

# 本机健康/参数接口（edge_link 自己调用 localhost）
health_url: "http://127.0.0.1:8090/ros/health"
params_url: "http://127.0.0.1:8090/ros/params"

# 上报给 ESP32 后，ESP32 用 remoteIP + 这些端口/路径代理模块接口
public_health_port: 8090
public_health_path: "/ros/health"
public_params_port: 8090
public_params_path: "/ros/params"

interval_sec: 5.0
health_timeout_sec: 3.0
params_timeout_sec: 3.0
