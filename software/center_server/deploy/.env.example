# Docker Compose 变量（复制为 center_server/.env 后按现场修改）
#   cp deploy/.env.example .env
#   docker compose -f deploy/docker-compose.yml up -d --build
#
# 注意：这些是 compose 变量，不是 systemd 的 center.env；后者见
# deploy/center.env.example。

# 是否在镜像里安装 torch/lerobot（1 构建约 2GB+；0 只跑 stub/CPU）
INSTALL_VLA=1
CENTER_VERSION=0.2.0

# 宿主机端口 -> 容器 8000
CENTER_PORT=8000

# Edge Server 地址（容器内不能用 127.0.0.1 指向 Pi）
EDGE_URL=http://192.168.3.26

# 模型：容器内路径；宿主机 models/ 挂载到 /models:ro
CENTER_MODEL_PATH=/models/smolvla_base
CENTER_DEVICE=auto

# 可选：覆盖挂载路径（相对 deploy/ 的上级目录）
# CENTER_CONFIG=../config.yaml
# CENTER_MODELS=../models
