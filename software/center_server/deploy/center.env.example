# /etc/rush-mog/center.env —— systemd EnvironmentFile 示例
# 复制后 chmod 600；只有 CENTER_SERVER_* 开头的变量会被 center_server 读取。

# 配置文件（也可在 ExecStart 用 --config 指定，二选一）
CENTER_SERVER_CONFIG=/opt/rush-mog-center/config.yaml

# Edge Server 基地址：握手目标 + dashboard 代理入口
# 树莓派 AP 默认 192.168.3.26；家用路由器网段按现场修改
CENTER_SERVER_EDGE_URL=http://192.168.3.26

# 本机监听（默认 0.0.0.0:8000）
CENTER_SERVER_HOST=0.0.0.0
CENTER_SERVER_PORT=8000

# 模型：本地目录优先；离线部署设 HF_HUB_OFFLINE=1
CENTER_SERVER_MODEL_PATH=/models/smolvla_base
CENTER_SERVER_DEVICE=cuda
CENTER_SERVER_DTYPE=float16
HF_HOME=/var/lib/rush-mog-center/huggingface
HF_HUB_OFFLINE=1

# 可选：保护 /v1/infer；Edge 侧 center.remote.api_key 需填相同值
# CENTER_SERVER_API_KEY=change-me
