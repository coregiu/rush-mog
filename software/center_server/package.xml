<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>center_server</name>
  <version>0.2.0</version>
  <description>Rush-MoG center_server: ROS2 VLA + SLAM/navigation/object-search center</description>
  <maintainer email="xxx@xxx.com">coregiu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <build_depend>setuptools</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <depend>custom_msgs</depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <!-- 可选：实车 I2C 直连 ICM-20948 时需要 python3-smbus2（pip 安装） -->
  <!-- 可选：定位融合/建图/导航依赖 robot_localization、slam_toolbox、nav2_bringup、nav2_msgs -->
  <!-- 这些包未作为硬依赖，避免无 Nav2 的轻量环境无法构建；见 README 与 DESIGN.md -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
